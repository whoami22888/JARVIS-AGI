<network-security-config>
    <!-- Base config: deny cleartext, use system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>

    <!-- AI Provider domains with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.openrouter.ai</domain>
        <domain includeSubdomains="true">api.deepinfra.com</domain>
        <domain includeSubdomains="true">api-inference.huggingface.co</domain>
        <domain includeSubdomains="true">api.deepseek.com</domain>
        <domain includeSubdomains="true">api.anthropic.com</domain>
        <domain includeSubdomains="true">api.openai.com</domain>
        <domain includeSubdomains="true">api.groq.com</domain>
        <domain includeSubdomains="true">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="true">oauth2.googleapis.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">graph.microsoft.com</domain>
        <domain includeSubdomains="true">login.microsoftonline.com</domain>
        <domain includeSubdomains="true">api.notion.com</domain>
        <domain includeSubdomains="true">api.dropboxapi.com</domain>
        <domain includeSubdomains="true">www.dropbox.com</domain>
        <domain includeSubdomains="true">discord.com</domain>
        <domain includeSubdomains="true">slack.com</domain>
        <domain includeSubdomains="true">accounts.spotify.com</domain>
        <domain includeSubdomains="true">api.spotify.com</domain>
        <domain includeSubdomains="true">api.telegram.org</domain>
        <domain includeSubdomains="true">graph.facebook.com</domain>
        <domain includeSubdomains="true">www.facebook.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- Backup pins for rotation - add actual SHA-256 pins here -->
            <pin algorithm="SHA-256">BASE64_PIN_PLACEHOLDER_1</pin>
            <pin algorithm="SHA-256">BASE64_PIN_PLACEHOLDER_2</pin>
        </pin-set>
        <trust-anchors><certificates src="system" /></trust-anchors>
    </domain-config>

    <!-- Debug config for local development (localhost) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>