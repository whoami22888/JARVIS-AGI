# Copy to ../.env on the USB. Do not commit the copied file.
USB_AGENT_HOME=/media/AI_AGENT_USB/runtime
USB_AGENT_DATA=/media/AI_AGENT_USB/data
USB_AGENT_CONFIG=/media/AI_AGENT_USB/config
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional. Obtain from the official DeepSeek platform; never copy it from an app.
DEEPSEEK_API_KEY=
# Reserve this much free storage before a model pull is permitted.
MODEL_FREE_SPACE_RESERVE_GB=12
# Gateway host; use loopback by default. Set a local LAN address only with an owner-controlled firewall.
USB_AGENT_HOST=127.0.0.1
USB_AGENT_PORT=8787
