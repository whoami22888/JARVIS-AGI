# Mobile clients must pair over HTTPS. Never place provider keys in the Android app.
PAIRING_CODE=replace-with-a-long-random-one-time-code
TOKEN_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=/srv/data
AGENT_PORT=8080

# Local-first, no-provider-fee route. Run Ollama on the gateway host and pull the selected model.
# For direct host execution, use http://127.0.0.1:11434/v1.
# For the included Docker gateway, use http://host.docker.internal:11434/v1.
LOCAL_OLLAMA_ENABLED=true
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OLLAMA_MODEL=deepseek-r1:7b

# Optional authorized cloud fallback. It is used only after the local Ollama route fails.
# Leave disabled and the gateway will never call a cloud provider.
CLOUD_FALLBACK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
